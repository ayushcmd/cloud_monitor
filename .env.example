# ==============================================================================
# Cloud Monitor - Environment Configuration Example
# Copy this file to .env before starting services in production/custom environments
# ==============================================================================

# Application Configuration
APP_NAME=CloudMonitor-API
APP_ENV=development
API_PORT=8000
FRONTEND_PORT=5173

# Security & CORS Configuration
# Comma-separated list of allowed origins. Do not use wildcard (*) with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
POSTGRES_PORT=5433
POSTGRES_USER=cloudmonitor
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_DB=cloudmonitor
DATABASE_URL=postgresql://cloudmonitor:replace_with_secure_db_password@postgres:5432/cloudmonitor

# JWT Authentication
# Secret key used to sign JWTs (HS256). Must be replaced with a secure random string (at least 32 chars) in production.
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Prometheus Configuration
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Must be set to a secure custom password in your local .env file. Never commit real passwords.
GRAFANA_ADMIN_PASSWORD=replace_with_secure_password

# Alertmanager Configuration
ALERTMANAGER_PORT=9093

# Exporters
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080
