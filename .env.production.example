# ==============================================================================
# CloudMonitor — Production Environment Configuration (.env)
# Host Target: AWS EC2 Ubuntu 24.04 (Public IP: 3.25.150.231)
# ==============================================================================
# INSTRUCTIONS FOR EC2 HOST:
# 1. On your EC2 server, copy this file to .env:
#      cp .env.production.example .env
# 2. Generate secure random values for JWT_SECRET_KEY and POSTGRES_PASSWORD:
#      openssl rand -hex 32      -> Use for JWT_SECRET_KEY
#      openssl rand -base64 24   -> Use for POSTGRES_PASSWORD
# 3. Replace the placeholder values below with your generated secrets.
# 4. NEVER commit your actual .env file to Git.
# ==============================================================================

# Application Environment
APP_NAME=CloudMonitor-API
APP_ENV=production

# Server Hostname / Public IP
SERVER_PUBLIC_IP=3.25.150.231

# Production CORS Whitelist
# Matches the server's public IP address and optional domain name
CORS_ORIGINS=http://3.25.150.231,http://localhost

# Optional External API Base URL for Frontend build
# Leave empty ("") to use same-origin reverse-proxy (/api/* -> backend:8000)
VITE_API_BASE_URL=

# PostgreSQL Database Configuration
# The database container is PRIVATE to the internal Docker network.
# Its port 5432 is NEVER exposed to the public internet.
POSTGRES_USER=cloudmonitor
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_DB=cloudmonitor
DATABASE_URL=postgresql://cloudmonitor:replace_with_secure_db_password@postgres:5432/cloudmonitor

# JWT Authentication
# Secret key used to sign access tokens (HS256). Must be at least 32 characters long.
JWT_SECRET_KEY=replace_with_secure_random_jwt_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
